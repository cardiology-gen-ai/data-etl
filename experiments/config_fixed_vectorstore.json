{
    "cardiology_protocols": {
        "indexing": {
            "name": "all_mini_cardiology_protocols",
            "description": "Documents containing medical protocols for cardiologic patients.",
            "type": "faiss",
            "distance": "cosine",
            "alias": "faiss_cardio_current"
        },
        "embeddings": {
            "deployment": "sentence-transformers/all-MiniLM-L6-v2",
            "kwargs": {
                "device": "cpu"
            }
        },
        "preprocessing": {
            "storage": {
                "parent_folder": "data_fix",
                "input_folder": "pdfdocs",
                "output_folder": "mddocs",
                "allowed_extensions": [
                    "pdf"
                ]
            },
            "images": {
                "dpi": 200,
                "tol": 40.0,
                "pad": 16.0,
                "caption_keywords": [
                    "Figure"
                ]
            },
            "chunking": {
                "markdown_first": true,
                "header_levels": 4,
                "splitter": "recursive",
                "chunk_size": 1000,
                "chunk_overlap": 200
            }
        },
        "knowledge_graph": {
    
            "pipeline": {
                "phase": "preprocess",
                "pdf_dir": "data_fix/pdfdocs",
                "work_root": "data_fix",
                "force_toc": true,
                "force_markdown": true,
                "force_anchors": true,
                "force_chunks": true
            },
            "logging": {
                "enabled": true,
                "dir": null
            },
            "providers": {
                "chat_provider": "openai",
                "embedding_provider": "openai",
                "local_files_only": false
            },
            "models": {
                "chat_model": "gpt-4.1-mini",
                "chat_model_path": "",
                "embedding_model": "text-embedding-3-small",
                "embedding_model_path": "",
                "chat_max_new_tokens": 1024
            },
            "graph_loader": {
                "batch_size": 200,
                "min_text_chars_to_embed": 20
            },
            "entities": {
                "max_sections": null,
                "max_sections_per_batch": 2,
                "max_batch_chars": 30000,
                "emergency_max_single_chars": 12000,
                "skip_processed": true,
                "export_review": true,
                "review_output_dir": null,
                "clear_previous_review": true,
                "include_source_preview_in_review": false
            },
            "entity_normalization": {
                "enabled": false,
                "doc_id": null,
                "backend": "umls_api",
                "model_name": "en_core_sci_sm",
                "linker_name": "umls",
                "threshold": 0.85,
                "max_candidates": 3,
                "use_acronyms": true,
                "acronym_dir": null,
                "force": false,
                "dry_run": false,
                "export_review": true,
                "review_output_dir": null,
                "fuzzy_threshold": 90,
                "api_cache_dir": null,
                "api_timeout": 30,
                "api_rate_limit_per_second": 2,
                "local_files_only": false,
                "min_available_memory_gb": 8.0
            },
            "section_embeddings": {
                "max_sections": 2,
                "batch_size": 8,
                "force_reembed": false,
                "include_title": true,
                "include_body": true,
                "max_chars_per_section": 8000
            },
            "quality": {
                "max_chunk_chars": 50000
            }
        }
    }
}

# Path to the JSON config used by the pipeline.
# If you run from /home/marta/projects/CardioAI, use data-etl/config.json.
CONFIG_PATH=config.json

# Standard/vector ETL integration.
# These are not needed by the KG smoke preprocessing phase, but they are still
# used by the standard ETL/vectorstore path.
APP_CONFIG_PATH=../cardiology-gen-ai/configs/config_allMini.json
QDRANT_URL=
INDEX_ROOT=./test_data/faiss_index

# Hugging Face
HF_TOKEN=

# Neo4j
# Local direct runs read these values from .env automatically.
# Local Neo4j:
NEO4J_URI=bolt://localhost:7687
# Neo4j Aura example:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

KG_NEO4J_MODE=local
LOCAL_NEO4J_URI=bolt://localhost:7687

# Plain OpenAI API. Keep the real key only in your local .env.
OPENAI_API_KEY=

# Non-secret KG experiment settings live in config.json under:
# cardiology_protocols.knowledge_graph
#
# Optional local override examples:
# KG_APP_ID=cardiology_protocols
# KG_PIPELINE_PHASE=preprocess
# KG_PDF_DIR=test_data/smoke/pdfdocs
# KG_WORK_ROOT=test_data/smoke

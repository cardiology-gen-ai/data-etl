# Path to the JSON config used by the pipeline.
# If you run from /home/marta/projects/CardioAI, use data-etl/config.json.
CONFIG_PATH=config.json

# Optional KG run logging.
KG_LOG_TO_FILE=true
# KG_LOG_DIR=first_prototype/logs

# Optional compact entity review exports.
KG_ENTITY_EXPORT_REVIEW=true
# KG_ENTITY_REVIEW_OUTPUT_DIR=first_prototype/entity_review
KG_ENTITY_CLEAR_PREVIOUS_REVIEW=true
KG_ENTITY_INCLUDE_SOURCE_PREVIEW_IN_REVIEW=false

# Neo4j
# Local direct runs read these values from .env automatically.
# Local Neo4j:
NEO4J_URI=bolt://localhost:7687
# Neo4j Aura example:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

KG_NEO4J_MODE=local
LOCAL_NEO4J_URI=bolt://localhost:7687

# OpenAI API key
OPENAI_API_KEY=

# UMLS key: must request permission to access UMLS data
UMLS_API_KEY=
UMLS_USERNAME=

# Old configs
APP_CONFIG_PATH=../cardiology-gen-ai/configs/config_allMini.json
QDRANT_URL=
INDEX_ROOT=./test_data/faiss_index
# Hugging Face
HF_TOKEN=

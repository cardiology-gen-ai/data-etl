{
    "cardiology_protocols": {
        "indexing": {
            "name": "cardiology_protocols_prova",
            "description": "Documents containing medical protocols for cardiologic patients.",
            "type": "bm25",
            "distance": "cosine",
            "alias": "",
            "embeddings": {
                "deployment": "qwen3-embedding:8b",
                "ollama": true,
                "kwargs": {}
            }
        },
        "preprocessing": {
            "storage": {
                "parent_folder": "data",
                "input_folder": "pdfdocs",
                "output_folder": "mddocs",
                "allowed_extensions": [
                    "pdf"
                ]
            },
            "images": {
                "dpi": 200,
                "tol": 40.0,
                "pad": 16.0,
                "caption_keywords": [
                    "Figure"
                ]
            },
            "chunking": {
                "markdown_first": true,
                "header_levels": 4,
                "splitter": "recursive",
                "chunk_size": 1000,
                "chunk_overlap": 200
            }
        }
    }
}